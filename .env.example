# Copiez ce fichier en ".env" et remplissez les valeurs avant de lancer le serveur

# Port d'ecoute du serveur
PORT=3000

# Cle secrete de session : generez une valeur aleatoire longue et gardez-la privee
# Vous pouvez en generer une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez_moi_par_une_valeur_aleatoire_longue

# Mettre a "production" une fois deploye derriere HTTPS (active les cookies securises)
NODE_ENV=development

# Facultatif : cle API Anthropic pour activer l'assistant IA.
# Creez un compte sur https://console.anthropic.com pour en obtenir une.
# Laissez vide si vous ne voulez pas utiliser l'assistant IA pour l'instant.
ANTHROPIC_API_KEY=

# Facultatif : integration avec l'API d'un operateur telecom pour la
# localisation par triangulation antennes-relais. NE FONCTIONNE QUE dans le
# cadre d'un acces legal transmis par l'operateur lui-meme (requisition
# judiciaire ou partenariat officiel) — voir README pour le detail.
# Laissez vide tant que vous n'avez pas recu ces informations.
TELECOM_API_URL=
TELECOM_API_KEY=
